{"nodes": [{"id": "readme_devsweep", "label": "DevSweep", "file_type": "document", "source_file": "README.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_why_devsweep", "label": "Why DevSweep: rebuildable build output piles up", "file_type": "rationale", "source_file": "README.md", "source_location": "L29-L39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dependencies and build output (Rust target 3-10 GB, node_modules 0.5-2 GB, unbounded global caches) accumulate; 63 GB of a 100 GB drive was Rust target. Manual deletion requires knowing which folders are safe, e.g. node_modules in Program Files belongs to an installed app."}, {"id": "readme_project_folder_ownership_rule", "label": "Project folder ownership rule (project file next to it, marker inside)", "file_type": "rationale", "source_file": "README.md", "source_location": "L108-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A folder only counts when its owning project file sits next to it; ambiguous names like build, target and bin also require a file the build tool writes inside, so user folders with the same name are never offered."}, {"id": "readme_supported_folder_types", "label": "29 supported project folder types", "file_type": "concept", "source_file": "README.md", "source_location": "L110-L124", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_global_package_caches", "label": "Global package caches cleaning", "file_type": "concept", "source_file": "README.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches live at fixed paths in the user folder; DevSweep empties the cache folder but keeps the folder itself, and runs pnpm store prune for the pnpm store so only unused packages are removed."}, {"id": "readme_pnpm_store_prune", "label": "pnpm store prune", "file_type": "concept", "source_file": "README.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_fixed_exclusion_list", "label": "Fixed scanner exclusion list", "file_type": "rationale", "source_file": "README.md", "source_location": "L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scanner never enters Program Files, AppData, .git, editor and toolchain folders, game libraries, resources folders (installed Electron apps ship node_modules + package.json there), and on Linux system folders, ~/.config, ~/.cache, ~/.local, Flatpak, Snap, Wine and Node version managers, where installed tools look like projects."}, {"id": "readme_never_follows_links", "label": "Never follows symlinks or junctions", "file_type": "rationale", "source_file": "README.md", "source_location": "L134", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deleting a junction inside node_modules removes only the link, never the target folder."}, {"id": "readme_in_use_locking", "label": "In-use folder locking", "file_type": "rationale", "source_file": "README.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A folder can't be selected when a program runs from it or a dev tool's working folder is inside the project; caches lock while their package manager runs. On Linux only the user's own processes are visible."}, {"id": "readme_recheck_before_delete", "label": "Re-check before delete (last-chance path checks)", "file_type": "rationale", "source_file": "README.md", "source_location": "L136", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Folder must be in the last scan, project file still present, not in use, and not a drive root, home folder, Windows folder, Linux system folder or link."}, {"id": "readme_check_first_marking", "label": "Check first marking (venv, PHP vendor)", "file_type": "rationale", "source_file": "README.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python virtual environments and PHP vendor folders are never auto-selected because recreating them can take more than one command."}, {"id": "readme_runs_as_normal_user", "label": "Runs as normal user, never self-elevates", "file_type": "rationale", "source_file": "README.md", "source_location": "L138", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Access-denied folders usually come from admin terminals or sudo; Windows offers an explicit Restart as administrator via UAC with the same rules, Linux shows a chown command instead of running as root."}, {"id": "readme_restart_as_administrator", "label": "Restart as administrator (Windows UAC)", "file_type": "concept", "source_file": "README.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_chown_hint", "label": "chown command hint for root-owned folders (Linux)", "file_type": "concept", "source_file": "README.md", "source_location": "L100-L104", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_real_savings_reporting", "label": "Reports real free-space change", "file_type": "rationale", "source_file": "README.md", "source_location": "L139", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm and Cargo hard links make counted size overstate what deletion frees, so the report shows the change in free disk space next to the counted size."}, {"id": "readme_permanent_deletion", "label": "Permanent deletion (no Recycle Bin)", "file_type": "rationale", "source_file": "README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moving 50 GB of node_modules to the Recycle Bin or Trash frees nothing."}, {"id": "readme_scan_review_delete_workflow", "label": "Scan, Review, Delete workflow", "file_type": "concept", "source_file": "README.md", "source_location": "L85-L95", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_unused_days_preselection", "label": "Preselect folders unused for N days (default 30)", "file_type": "concept", "source_file": "README.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tauri_2", "label": "Tauri 2 (Rust backend + plain HTML/CSS/JS UI)", "file_type": "concept", "source_file": "README.md", "source_location": "L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UI in ui/ is plain HTML, CSS and JavaScript with no build step."}, {"id": "readme_rules_module", "label": "rules.rs (folder rules, exclusions, cache entries)", "file_type": "concept", "source_file": "README.md", "source_location": "L224", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_scan_module", "label": "scan.rs (parallel walk and sizing)", "file_type": "concept", "source_file": "README.md", "source_location": "L225", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_procs_module", "label": "procs.rs (running programs using a folder)", "file_type": "concept", "source_file": "README.md", "source_location": "L226", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_clean_module", "label": "clean.rs (deletion and last-chance checks)", "file_type": "concept", "source_file": "README.md", "source_location": "L227", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_main_module", "label": "main.rs (Tauri commands)", "file_type": "concept", "source_file": "README.md", "source_location": "L228", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_tests_module", "label": "tests.rs (fake-project tests)", "file_type": "concept", "source_file": "README.md", "source_location": "L205-L229", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_project_rule", "label": "ProjectRule / PROJECT_RULES", "file_type": "concept", "source_file": "README.md", "source_location": "L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_cache_entries", "label": "cache_entries", "file_type": "concept", "source_file": "README.md", "source_location": "L245", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_ci_workflow", "label": "CI workflow (ci.yml, Windows and Linux)", "file_type": "concept", "source_file": "README.md", "source_location": "L211", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_release_workflow", "label": "Release workflow (release.yml, tag-driven builds)", "file_type": "concept", "source_file": "README.md", "source_location": "L231-L239", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downloads are built only when a GitHub Release is published; the version comes from the v-prefixed tag so tauri.conf.json needs no edit."}, {"id": "readme_platform_packages", "label": "Windows and Linux packages (NSIS, portable zip, deb, rpm, AppImage)", "file_type": "concept", "source_file": "README.md", "source_location": "L51-L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_limits", "label": "Limits (no macOS, Linux own-process lock only, no root restart)", "file_type": "concept", "source_file": "README.md", "source_location": "L163-L169", "source_url": null, "captured_at": null, "author": null, "contribut