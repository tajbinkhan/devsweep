<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer". SignPath keeps its own copy: paste this file
  into the project's artifact configuration with the slug "installer" whenever it changes here.

  Signs the NSIS installer that the authenticode job in release.yml builds around the signed
  exe. SignPath refuses to sign it unless it is named DevSweep and carries the version being
  released.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file-set product-name="DevSweep" product-version="${version}" file-version="${version}">
      <include path="DevSweep_${version}_x64-setup.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
