{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevSweep",
  "version": "0.1.0",
  "identifier": "dev.devsweep.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DevSweep",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0MUIzN0E0QTQ1RjI3MkUKUldRdUoxK2twRGNiNU9wNldOU2NQNys4MDF1M0Y5dkdLV3FIWVc1VERLVi9Ec0NqM2FMNmZkTmgK",
      "endpoints": ["https://github.com/tajbinkhan/devsweep/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
